# Required: Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_THINKING_LEVEL=medium
GEMINI_MEDIA_RESOLUTION=low

# Required: public OAuth issuer, no trailing slash
PUBLIC_BASE_URL=https://your-service.up.railway.app

# Required: password shown on the ChatGPT OAuth authorization screen
OAUTH_LOGIN_PASSWORD=change-me

# Required: random >=32-character signing secret for the login session cookie
OAUTH_SESSION_SECRET=change-me-to-a-long-random-secret

# Persistent SQLite path (mount a Railway volume at /data)
OAUTH_DB_PATH=/data/oauth.sqlite3

# Optional OAuth TTLs
OAUTH_ACCESS_TOKEN_TTL_SECONDS=3600
OAUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
OAUTH_AUTH_CODE_TTL_SECONDS=300
OAUTH_SESSION_TTL_SECONDS=2592000

# Optional static Bearer key for agents that do not implement OAuth.
# OAuth remains available for ChatGPT.
MCP_API_KEY=
